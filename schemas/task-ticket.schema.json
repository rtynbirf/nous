{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nous.local/schemas/task-ticket.schema.json",
  "title": "TaskTicket",
  "type": "object",
  "required": ["id", "title", "status", "created"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string", "minLength": 5 },
    "status": { "type": "string", "enum": ["open", "in_progress", "done", "failed", "escalated"] },
    "created": { "type": "string", "format": "date-time" },
    "assignee_subject": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
    "scope_hint": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "budget_override": { "type": "object" }
  },
  "additionalProperties": true
}
